{
  "name": "whatfont-webextension",
  "version": "1.3",
  "description": "The easiest way to identify fonts on web pages",
  "main": "whatfont_core.js",
  "scripts": {
    "build": "web-ext build --source-dir . --artifacts-dir web-ext-artifacts --ignore-files package.json package-lock.json node_modules .git .github",
    "lint": "web-ext lint --source-dir .",
    "start": "web-ext run --source-dir .",
    "sign": "web-ext sign --source-dir . --artifacts-dir web-ext-artifacts"
  },
  "keywords": [
    "font",
    "typography",
    "webfont",
    "css",
    "firefox",
    "extension"
  ],
  "author": "Cheng Yin Liu",
  "license": "MIT",
  "devDependencies": {
    "web-ext": "^7.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/defmikekoh/whatfont-webextension.git"
  },
  "bugs": {
    "url": "https://github.com/defmikekoh/whatfont-webextension/issues"
  },
  "homepage": "https://github.com/defmikekoh/whatfont-webextension#readme"
}
